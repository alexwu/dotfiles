#!/bin/bash
# Rebuilds compiled binaries from scripts/ into ~/.local/bin/.
# chezmoi re-runs this script whenever the rendered template changes;
# source-file hashes below are what make the template change on edit.
# Agent hooks and CLIs build from ~/Code/lulu-loadout (`just install`), not here.

set -euo pipefail

mkdir -p "$HOME/.local/bin"

# ---- heic-ai-rename (Nim) ----
# source hash: {{ include (joinPath .chezmoi.sourceDir "scripts/hazel/heic_ai_rename.nim") | sha256sum }}
{
  SOURCE="{{ joinPath .chezmoi.sourceDir "scripts/hazel/heic_ai_rename.nim" }}"
  TARGET="$HOME/.local/bin/heic-ai-rename"

  if ! command -v nim >/dev/null 2>&1; then
    echo "build-scripts: nim not found on PATH, skipping heic-ai-rename" >&2
  else
    nim c -d:release --opt:size --hints:off -o:"$TARGET" "$SOURCE"
    echo "build-scripts: built $TARGET"
  fi
}

# ---- image-sort (Nim, requires json_serialization) ----
# source hash: {{ include (joinPath .chezmoi.sourceDir "scripts/hazel/image_sort.nim") | sha256sum }}
{
  SOURCE="{{ joinPath .chezmoi.sourceDir "scripts/hazel/image_sort.nim" }}"
  TARGET="$HOME/.local/bin/image-sort"

  if ! command -v nim >/dev/null 2>&1; then
    echo "build-scripts: nim not found on PATH, skipping image-sort" >&2
  elif ! command -v nimble >/dev/null 2>&1; then
    echo "build-scripts: nimble not found on PATH, skipping image-sort" >&2
  else
    if ! nimble path json_serialization >/dev/null 2>&1; then
      echo "build-scripts: installing json_serialization for image-sort"
      nimble install -y json_serialization >/dev/null
    fi
    nim c -d:release --opt:size --hints:off -o:"$TARGET" "$SOURCE"
    echo "build-scripts: built $TARGET"
  fi
}

