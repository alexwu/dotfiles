# Sourced by EVERY zsh — including the non-interactive $SHELL -c that sshd and
# `ssh host 'cmd'` run — so keep it fast: no evals, no forks. .zprofile still does
# the full brew/mise setup for login shells; typeset -U dedupes the overlap.
typeset -U path
path=(/opt/homebrew/bin /opt/homebrew/sbin $HOME/.local/bin $path)
export PATH

# rustup's ~/.cargo/bin ahead of Homebrew rust. Not `. ~/.cargo/env`: it skips
# the prepend when the dir is already on an inherited PATH, even behind Homebrew.
[[ -d $HOME/.cargo/bin ]] && path=($HOME/.cargo/bin $path)

# Local sessions use this machine's 1Password SSH agent; ssh sessions keep the
# forwarded agent sshd already put in SSH_AUTH_SOCK. ~/.ssh/config carries the
# matching IdentityAgent conditional for OpenSSH itself (which outranks this env
# var); this export covers everything that only reads SSH_AUTH_SOCK.
if [[ -z "${SSH_CONNECTION:-}" && -S "$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
fi

# Which of the attaching terminal's variables the session records. The attach
# client reads this (not the host): `bmx attach`, when BMX_TRACK_ENV is unset,
# and `zmx attach`. So it lives here, where every zsh that can attach sees it:
# wezterm's `zsh -c zn` and an interactive `bmx dash` alike. It replaces the
# built-in list, so the first line restates
# those defaults; the second adds the terminal identifiers the session shell
# should follow (__CFBundleIdentifier names the terminal app itself). PATH,
# HOME and TERM stay out: they belong to the shell, not to whichever terminal
# is attached. ~/.zsh/zmx.zsh applies the values per prompt; the notify hook,
# statusline and wezrun read them live through lulu-loadout's lib/term_env.nim.
export ZMX_TRACK_ENV="DISPLAY,SSH_AUTH_SOCK,SSH_AGENT_PID,SSH_CONNECTION,WINDOWID,XAUTHORITY,KITTY_LISTEN_ON,KITTY_PID,KITTY_WINDOW_ID\
,TERM_PROGRAM,__CFBundleIdentifier,WEZTERM_PANE,WEZTERM_UNIX_SOCKET,BTTY_PANE,BTTY_TAB,BTTY_WORKSPACE,BTTY_SOCK,BTTY_DIR"
