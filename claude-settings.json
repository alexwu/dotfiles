{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "SHELL": "/opt/homebrew/bin/bash",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "ALLOW_LLM_DECIDE": "1",
    "NEXTEST_STATUS_LEVEL": "fail",
    "NEXTEST_FINAL_STATUS_LEVEL": "fail",
    "NEXTEST_FAILURE_OUTPUT": "final",
    "PREK_QUIET": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "/Users/jamesbombeelu/.local/share/lulu-loadout/mods/bash-format:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/beads-pane:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/inline-pictures:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/knock:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/running:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/thread:/Users/jamesbombeelu/Code/lulu-prompts/mods/luna-sections"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(/tmp/**)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "mcp__plugin_github_github__issue_read",
      "mcp__plugin_github_github__pull_request_read",
      "Bash(ls *)",
      "Bash(eza *)",
      "Bash(tree *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(whoami)",
      "Bash(date)",
      "Bash(uname *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)"
    ],
    "deny": [
      "Agent(Explore)"
    ],
    "ask": [
      "Bash(heroku run:*)",
      "Bash(heroku ps:*)",
      "Bash(heroku config:set*)",
      "Bash(heroku pg:*)",
      "Bash(heroku restart*)",
      "Bash(heroku scale*)",
      "Bash(railway run:*)",
      "Bash(railway up*)",
      "Bash(railway redeploy*)",
      "Bash(railway down*)",
      "Bash(railway service*)",
      "Bash(railway variables*)",
      "Bash(railway volume*)",
      "Bash(gh release create*)",
      "Bash(npm publish*)",
      "Bash(cargo publish*)",
      "Bash(chezmoi apply*)",
      "Bash(chezmoi destroy*)",
      "Bash(chezmoi purge*)",
      "Bash(chezmoi forget*)",
      "Bash(chezmoi init*)",
      "Bash(brew install*)",
      "Bash(brew uninstall*)",
      "Bash(brew bundle*)",
      "Bash(brew tap*)",
      "Bash(brew untap*)",
      "Bash(mise install*)",
      "Bash(mise use*)",
      "Bash(mise uninstall*)",
      "Bash(mise plugin*)",
      "Bash(cargo install*)",
      "Bash(cargo binstall*)",
      "Bash(cargo uninstall*)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(bun install -g*)",
      "Bash(bun add -g*)",
      "Bash(bun i -g*)",
      "Bash(pnpm add -g*)",
      "Bash(yarn global add*)",
      "Bash(gem install*)",
      "Bash(pipx install*)",
      "Bash(pipx uninstall*)",
      "Bash(uv tool install*)",
      "Bash(uv tool uninstall*)",
      "Bash(uv pip install*)",
      "Bash(pip install*)",
      "Bash(nimble install*)",
      "Bash(go install*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/secret-guard",
            "statusMessage": "Checking for sensitive paths..."
          },
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/git-add-guard",
            "statusMessage": "Checking git add pattern..."
          },
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/truncation-guard",
            "statusMessage": "Checking for output truncation..."
          },
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/wezterm-guard",
            "statusMessage": "Checking for destructive wezterm cli..."
          },
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/inline-script-guard",
            "statusMessage": "Checking for inline scripts..."
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/notify PreToolUse"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/sec-guard check",
            "timeout": 5,
            "statusMessage": "Security check..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "G=\"$HOME/.claude/plans/.gate-plan.md\"; jaq -r '.tool_input.plan // empty' > \"$G\"; [ -s \"$G\" ] || exit 0; OUT=$(\"$HOME/.local/bin/check-plan\" --fix \"$G\" 2>&1); [ $? -eq 1 ] || exit 0; jaq -n --arg r \"$OUT\" '{hookSpecificOutput: {hookEventName: \"PreToolUse\", permissionDecision: \"deny\", permissionDecisionReason: (\"check-plan failed on the submitted plan. Fix the plan file, rerun check-plan --fix on it, then call ExitPlanMode again.\\n\\n\" + $r)}}'",
            "timeout": 60,
            "statusMessage": "Checking plan..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "PLAN_FILE=\"$HOME/.claude/plans/.current-plan.md\"; jaq -r '.tool_input.plan // empty' > \"$PLAN_FILE\" && [ -s \"$PLAN_FILE\" ] && ( zed \"$PLAN_FILE\" >/dev/null 2>&1 & ); true",
            "statusMessage": "Opening plan in Zed...",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|WebFetch|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/notify PostToolUse"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/notify Notification"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/sec-guard cleanup",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/notify SessionEnd"
          },
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/zmx-agent-label unset claude",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/zmx-agent-label set claude",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_ENV_FILE\" ] || exit 0; rg -qF 'mise/shims' \"$CLAUDE_ENV_FILE\" 2>/dev/null || printf 'export PATH=\"%s/.local/share/mise/shims:$PATH\"\\n' \"$HOME\" >> \"$CLAUDE_ENV_FILE\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/notify UserPromptSubmit"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/jamesbombeelu/.local/bin/tool-failure-log",
            "timeout": 5,
            "statusMessage": "Logging lulu-tool failure..."
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.local/bin/claude-statusline",
    "padding": 0,
    "refreshInterval": 1,
    "hideVimModeIndicator": true
  },
