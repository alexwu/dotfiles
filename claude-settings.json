      "Bash(chezmoi destroy*)",
      "Bash(chezmoi purge*)",
      "Bash(chezmoi forget*)",
      "Bash(chezmoi init*)",
      "Bash(brew install*)",
      "Bash(brew uninstall*)",
      "Bash(brew bundle*)",
      "Bash(brew tap*)",
      "Bash(brew untap*)",
      "Bash(mise install*)",
      "Bash(mise use*)",
      "Bash(mise uninstall*)",
      "Bash(mise plugin*)",
      "Bash(cargo install*)",
      "Bash(cargo binstall*)",
      "Bash(cargo uninstall*)",
      "Bash(npm install -g*)",
      "Bash(npm i -g*)",
      "Bash(bun install -g*)",
      "Bash(bun add -g*)",
      "Bash(bun i -g*)",
      "Bash(pnpm add -g*)",
      "Bash(yarn global add*)",
