{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "env": {
    "SHELL": "/opt/homebrew/bin/bash",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1",
    "ENABLE_CLAUDEAI_MCP_SERVERS": "0",
    "ALLOW_LLM_DECIDE": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "CLAUDE_CODE_PLUGIN_DIRS": "/Users/jamesbombeelu/.local/share/lulu-loadout/mods/bash-format:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/beads-pane:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/inline-pictures:/Users/jamesbombeelu/.local/share/lulu-loadout/mods/knock:/Users/jamesbombeelu/Code/lulu-prompts/mods/luna-sections"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(/tmp/**)",
      "Bash(gh issue view *)",
      "Bash(gh pr view *)",
      "mcp__plugin_github_github__issue_read",
      "mcp__plugin_github_github__pull_request_read",
      "Bash(ls *)",
      "Bash(eza *)",
      "Bash(tree *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(command -v *)",
      "Bash(whoami)",
      "Bash(date)",
      "Bash(uname *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git remote *)"
    ],
    "deny": [
      "Agent(Explore)"
