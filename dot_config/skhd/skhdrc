# Keychron Q0 Max numpad workspace launcher. These are the macOS virtual
# keycodes reported by `skhd --observe`; skhd.zig only scopes `.remap` rules to
# `.device`, and its current HID remap table does not include keypad sources.
$q0_num1 : aerospace workspace 1
$q0_num2 : aerospace workspace 2
$q0_num3 : aerospace workspace 3
$q0_num4 : aerospace workspace 4
$q0_num5 : aerospace workspace 5
$q0_num0 : aerospace workspace 0
$q0_num_decimal : aerospace layout h_accordion h_tiles

# Lens front-door (lulu-select-1ry): the daemon resolves these TOML recipes from
# ~/.local/share/lulu-select/lenses/ instead of the standalone launcher scripts.
# Requires a `just install` to have seeded the built-in lenses (incl. meta.toml).
cmd - space : /Users/jamesbombeelu/.local/bin/lulu-select meta
cmd + alt - e : /Users/jamesbombeelu/.local/bin/lulu-select emoji
# Snippets: fires the picked espanso match into the previously-focused app
# (the Lens's actions.default runs `espanso match exec`). Replaces the old
# espick script.
ctrl + alt + cmd - s : /Users/jamesbombeelu/.local/bin/lulu-select snippets
