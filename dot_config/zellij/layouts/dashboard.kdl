// Dashboard glance wall — column-first for an ultrawide monitor. Launch:
//   zellij --config ~/.config/zellij/dashboard.config.kdl --layout dashboard
layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zellij:compact-bar"
        }
    }
    tab name="glance" focus=true {
        pane split_direction="vertical" {
            pane command="btm" size="33%" borderless=true
            pane name="mission-control" command="mission-control" size="37%" borderless=true {
                args "--watch" "2"
            }
            pane size="30%" split_direction="horizontal" {
                pane name="pueue" command="sh" size="35%" borderless=true {
                    args "-c" "while true; do clear; pueue status 2>/dev/null; sleep 2; done"
                }
                pane name="gh-dash" command="gh" borderless=true {
                    args "dash"
                }
            }
        }
    }
}
