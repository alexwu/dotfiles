[arg("model", long="model", short="m")]
[arg("provider", long="provider", short="p")]
[doc("Conventional Commit message for staged diff via `llm`: J llm-commit-message [-p PROVIDER] [-m MODEL]")]
[group("llm")]
[no-cd]
llm-commit-message provider="codex" model="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -z $(git diff --cached --stat 2>/dev/null) ]]; then
        echo "llm-commit-message: nothing staged. Run 'git add <files>' first." >&2
        exit 1
    fi
    args=(--provider {{ quote(provider) }})
    if [[ -n {{ quote(model) }} ]]; then
        args+=(--model {{ quote(model) }})
    fi
    git diff --cached | llm "${args[@]}" --prompt-file commit-message

[arg("base", long="base", short="b")]
[arg("model", long="model", short="m")]
[arg("provider", long="provider", short="p")]
[doc("PR description via `llm`. Local (HEAD vs auto-detected base) by default; pass a PR URL/number to run against a remote PR. Usage: J llm-pr-description [-p PROVIDER] [-m MODEL] [-b BASE] [PR_URL_OR_NUMBER]")]
[group("llm")]
[no-cd]
llm-pr-description provider="codex" model="" base="" target="":
    #!/usr/bin/env bash
    set -euo pipefail

    provider={{ quote(provider) }}
    model={{ quote(model) }}
    base_override={{ quote(base) }}
    target={{ quote(target) }}

    if [[ -n "$target" ]]; then
        # Remote mode: fetch metadata + diff from GitHub via gh.
        meta=$(gh pr view "$target" --json baseRefName,headRefOid,headRepositoryOwner,headRepository,commits 2>/dev/null) || {
            echo "llm-pr-description: 'gh pr view $target' failed. Check the URL/number and that gh is authenticated." >&2
            exit 1
        }
        repo=$(jaq -r '.headRepositoryOwner.login + "/" + .headRepository.name' <<<"$meta")
        head_sha=$(jaq -r '.headRefOid' <<<"$meta")
        base=$(jaq -r '.baseRefName' <<<"$meta")
        commit_log=$(jaq -r '.commits[] | (.oid[0:7] + " " + .messageHeadline)' <<<"$meta")
        diff=$(gh pr diff "$target")
    else
        # Local mode: HEAD vs base in the current repo.
        if ! git rev-parse --git-dir >/dev/null 2>&1; then
            echo "llm-pr-description: not a git repository. Pass a PR URL or number to run against a remote PR." >&2
            exit 1
        fi
        if [[ -n "$base_override" ]]; then
            base=$base_override
        else
            # Auto-detect default branch: prefer origin/HEAD, then main, then master.
            base=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||' || true)
            if [[ -z "$base" ]]; then
                for candidate in main master; do
                    if git rev-parse --verify "$candidate" >/dev/null 2>&1; then
                        base=$candidate
                        break
                    fi
                done
            fi
            if [[ -z "$base" ]]; then
                echo "llm-pr-description: could not auto-detect base branch (tried origin/HEAD, main, master). Pass -b <branch>." >&2
                exit 1
            fi
        fi
        if ! git rev-parse --verify "$base" >/dev/null 2>&1; then
            echo "llm-pr-description: base branch '$base' not found." >&2
            exit 1
        fi
        if [[ -z "$(git log "$base..HEAD" --oneline 2>/dev/null)" ]]; then
            echo "llm-pr-description: HEAD has no commits ahead of '$base'." >&2
            exit 1
        fi
        head_sha=$(git rev-parse HEAD)
        repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
        commit_log=$(git log "$base..HEAD" --oneline)
        diff=$(git diff "$base...HEAD")
    fi

    args=(--provider "$provider")
    if [[ -n "$model" ]]; then
        args+=(--model "$model")
    fi

    {
        printf '<repo>%s</repo>\n' "$repo"
        printf '<head_sha>%s</head_sha>\n' "$head_sha"
        printf '<base_branch>%s</base_branch>\n\n' "$base"
        printf '<commit_log>\n%s\n</commit_log>\n\n' "$commit_log"
        printf '<diff>\n%s\n</diff>\n' "$diff"
    } | llm "${args[@]}" --prompt-file pr-description

[doc("Refresh tree-sitter grammars: hx fetch + build, then rebuild tree-sitter-<lang> symlinks")]
[group("tree-sitter")]
ts-grammars-update:
    #!/usr/bin/env bash
    set -euo pipefail
    hx --grammar fetch
    hx --grammar build
    SOURCES_DIR="$HOME/.config/helix/runtime/grammars/sources"
    PARSERS_DIR="$HOME/.local/share/tree-sitter/parsers"
    mkdir -p "$PARSERS_DIR"
    find "$PARSERS_DIR" -maxdepth 1 -type l -name 'tree-sitter-*' -delete
    count=0
    for src in "$SOURCES_DIR"/*/; do
        [[ -d "$src" ]] || continue
        src="${src%/}"
        ln -sf "$src" "$PARSERS_DIR/tree-sitter-$(basename "$src")"
        count=$((count + 1))
    done
    echo "linked $count grammars into $PARSERS_DIR"

[doc("List tree-sitter grammars currently linked for the CLI")]
[group("tree-sitter")]
ts-grammars-list:
    tree-sitter dump-languages | rg '^scope:'

[doc("Highlight FILE via lumis (snazzy theme); falls back to bat for filetypes lumis doesn't recognize.")]
[group("lumis")]
[no-cd]
hl FILE:
    #!/usr/bin/env bash
    set -euo pipefail
    file="{{ FILE }}"
    # lumis emits ANSI when it has a grammar; otherwise prints plaintext.
    # Detect that and fall back to bat for richer language coverage.
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    lumis highlight -t snazzy "$file" 2>/dev/null > "$tmp" || true
    if rg -q --max-count=1 $'\x1b\\[' "$tmp"; then
        cat "$tmp"
    else
        exec bat --color=always --paging=never --style=plain "$file"
    fi

[doc("Regenerate snazzy theme JSON for lumis. Re-adds to chezmoi source on success.")]
[group("lumis")]
lumis-regen-snazzy:
    #!/usr/bin/env bash
    set -euo pipefail
    out="$HOME/.local/share/lumis/themes/snazzy.json"
    lumis themes generate \
        -u https://github.com/alexwu/nvim-snazzy \
        -c snazzy \
        -s 'vim.pack.add({{{{ src = "https://github.com/rktjmp/lush.nvim" }}}}, { load = true, confirm = false }); vim.opt.runtimepath:prepend(vim.fn.stdpath("data") .. "/site/pack/core/opt/lush.nvim")' \
        -o "$out"
    chezmoi re-add "$out"

[doc("Launch the gh-dash Ghostty window and pin it to workspace D. Run at login by AeroSpace's after-startup-command, or by hand: J launch-dash")]
[group("aerospace")]
launch-dash:
    #!/usr/bin/env bash
    set -euo pipefail
    bundle_id='com.mitchellh.ghostty'
    title='GitHub Dash'
    target_ws='D'

    # All Ghostty window-ids currently titled "$title".
    list_dash() {
        aerospace list-windows --monitor all --app-bundle-id "$bundle_id" \
            --format '%{window-id}|%{window-title}' \
            | awk -F'|' -v t="$title" '$2 ~ t {print $1}' || true
    }

    # Snapshot existing dash windows so we move the one we launch, not a stray.
    before=$(list_dash)

    open -na Ghostty.app --args \
        --config-file="$HOME/.config/ghostty/dashboard.ghostty" \
        --title="$title" -e gh dash

    # AeroSpace's on-window-detected title rule is a fast path but races
    # Ghostty's title-set against the AX observer (~2/3 hit rate); poll for the
    # newly-created window by id and move it so placement is deterministic.
    # Idempotent: if the rule already put it on D, the move no-ops.
    for _ in $(seq 1 50); do
        new=$(awk 'NR==FNR{seen[$0]=1; next} !($0 in seen){print; exit}' \
            <(printf '%s\n' "$before") <(list_dash))
        if [[ -n "$new" ]]; then
            aerospace move-node-to-workspace "$target_ws" --window-id "$new"
            break
        fi
        sleep 0.1
    done

# duckyPad Pro: edit DuckyScript profiles without the configurator GUI.
# Each profile dir holds keyN.txt (DuckyScript source) + keyN.dsb (compiled
# bytecode the device actually runs) + config.txt (labels/colors). The device
# executes the .dsb, so a .txt edit MUST be recompiled or the change is ignored.
# Compiler: github.com/duckypad/DuckStack (needs Python 3.10+), auto-cloned to
# ~/.local/opt/DuckStack by chezmoi (.chezmoiexternal.toml). Override with $DUCKYPAD_COMPILER.
DUCKYPAD_COMPILER := env('DUCKYPAD_COMPILER', home_directory() / ".local/opt/DuckStack/ds_compiler/dsvm_make_bytecode.py")

[doc("Print the mounted duckyPad SD card path (detected by its dpp_config.txt serial signature, not a hardcoded volume name).")]
[group("duckypad")]
duckypad-card:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    for cfg in /Volumes/*/dpp_config.txt; do
        if rg -q '^serial_number[[:space:]]+DP24' "$cfg"; then
            dirname "$cfg"
            exit 0
        fi
    done
    echo "duckypad-card: no duckyPad card found under /Volumes (plugged in and mounted?)" >&2
    exit 1

[doc("Compile every keyN.txt -> keyN.dsb in a profile dir. Usage: J duckypad-build path/to/profile_Foo")]
[group("duckypad")]
[no-cd]
duckypad-build PROFILE:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    profile="{{ PROFILE }}"
    compiler="{{ DUCKYPAD_COMPILER }}"
    [[ -d "$profile" ]] || { echo "duckypad-build: '$profile' is not a directory" >&2; exit 1; }
    [[ -f "$compiler" ]] || { echo "duckypad-build: compiler not found at '$compiler' (clone github.com/duckypad/DuckStack or set \$DUCKYPAD_COMPILER)" >&2; exit 1; }
    profile="$(cd "$profile" && pwd)"
    # The DuckStack CLI unconditionally dumps pgmlst0/1/2 debug files into cwd;
    # run it inside a throwaway dir so the debris never lands in the repo or a profile.
    scratch="$(mktemp -d)"
    trap 'rm -rf "$scratch"' EXIT
    count=0
    for txt in "$profile"/key*.txt; do
        dsb="${txt%.txt}.dsb"
        if ! ( cd "$scratch" && python3 "$compiler" "$txt" "$dsb" ) >/dev/null 2>&1; then
            echo "duckypad-build: FAILED to compile $txt — compiler output:" >&2
            ( cd "$scratch" && python3 "$compiler" "$txt" "$dsb" ) >&2 || true
            exit 1
        fi
        count=$((count + 1))
    done
    echo "duckypad-build: compiled $count key(s) in $(basename "$profile")"

[confirm("Copy this profile onto the duckyPad card? Overwrites the matching profile on the device.")]
[doc("Build a profile then mirror it onto the duckyPad card and verify the bytecode landed intact. Usage: J duckypad-push path/to/profile_Foo")]
[group("duckypad")]
[no-cd]
duckypad-push PROFILE: (duckypad-build PROFILE)
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob
    profile="{{ PROFILE }}"
    profile="${profile%/}"
    name="$(basename "$profile")"
    card="$({{ just_executable() }} -g duckypad-card)"
    dest="$card/$name"
    rsync -a --exclude='._*' --exclude='.DS_Store' "$profile/" "$dest/"
    /usr/sbin/dot_clean "$card" >/dev/null 2>&1 || true
    fail=0
    for dsb in "$profile"/key*.dsb; do
        if ! cmp -s "$dsb" "$dest/$(basename "$dsb")"; then
            echo "duckypad-push: VERIFY MISMATCH on $(basename "$dsb")" >&2
            fail=1
        fi
    done
    [[ $fail -eq 0 ]] || { echo "duckypad-push: verification failed — card may be out of sync" >&2; exit 1; }
    echo "duckypad-push: '$name' synced to $card and verified"

[doc("Launch the zellij dashboard wall (btm + agent-sessions + pueue + gh-dash) and pin it to workspace D. By hand: J launch-dashboard")]
[group("aerospace")]
launch-dashboard:
    #!/usr/bin/env bash
    set -euo pipefail
    bundle_id='com.mitchellh.ghostty'
    title='GitHub Dash'
    target_ws='D'

    list_dash() {
        aerospace list-windows --monitor all --app-bundle-id "$bundle_id" \
            --format '%{window-id}|%{window-title}' \
            | awk -F'|' -v t="$title" '$2 ~ t {print $1}' || true
    }

    # Snapshot existing dash windows so we move the one we launch, not a stray.
    before=$(list_dash)

    # Login shell (zsh -lc) so the panes inherit a full PATH even when this is
    # invoked from AeroSpace's minimal-env after-startup-command. `exec` so the
    # window closes cleanly when zellij exits. Bare `--layout dashboard` resolves
    # from ~/.config/zellij/layouts/; do NOT add `--session` (it turns --layout
    # into a tab-add against a non-existent session).
    open -na Ghostty.app --args \
        --config-file="$HOME/.config/ghostty/dashboard.ghostty" \
        --title="$title" \
        -e zsh -lc 'exec zellij --config "$HOME/.config/zellij/dashboard.config.kdl" --layout dashboard'

    for _ in $(seq 1 50); do
        new=$(awk 'NR==FNR{seen[$0]=1; next} !($0 in seen){print; exit}' \
            <(printf '%s\n' "$before") <(list_dash))
        if [[ -n "$new" ]]; then
            aerospace move-node-to-workspace "$target_ws" --window-id "$new"
            break
        fi
        sleep 0.1
    done

# Create GitHub linked branch(es) from an issue, mirroring the website's "Create a
# branch" button. Cross-repo aware: the issue can live in one repo (default
# cleverific/support) while the branch is created in one or more OTHER repos, via
# `gh issue develop`'s --repo (issue) + --branch-repo (branch) split. GitHub only
# allows the branch repo to share the issue repo's owner/org (all cleverific/* here).
# Omit -b to use each repo's own default branch; omit -n to auto-name from the issue
# title. Does not check out (multi-repo) — git fetch && checkout after. List existing
# links with: gh issue develop --repo <issue-repo> --list <issue>.
[doc("Create GitHub linked branch(es) from an issue across one or more repos. Flags: -r ISSUE_REPO (default cleverific/support), -b BASE, -n NAME. Usage: J gh-issue-branch [-r cleverific/support] 456 cleverific/editorder [cleverific/pro-platform ...]")]
[group("github")]
[no-cd]
[positional-arguments]
gh-issue-branch *args:
    #!/usr/bin/env bash
    set -euo pipefail
    issue_repo="cleverific/support"
    base=""
    name=""
    usage="usage: J gh-issue-branch [-r ISSUE_REPO] [-b BASE] [-n NAME] <issue> <branch-repo> [branch-repo...]"
    positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r | --repo) issue_repo="$2"; shift 2 ;;
            -b | --base) base="$2"; shift 2 ;;
            -n | --name) name="$2"; shift 2 ;;
            -h | --help) echo "$usage"; exit 0 ;;
            --) shift; while [[ $# -gt 0 ]]; do positional+=("$1"); shift; done ;;
            -*) echo "gh-issue-branch: unknown flag $1" >&2; echo "$usage" >&2; exit 1 ;;
            *) positional+=("$1"); shift ;;
        esac
    done
    set -- "${positional[@]}"
    issue="${1:-}"
    shift || true
    if [[ -z "$issue" || $# -eq 0 ]]; then
        echo "$usage" >&2
        exit 1
    fi
    for branch_repo in "$@"; do
        gh_args=("$issue" --repo "$issue_repo" --branch-repo "$branch_repo")
        [[ -n "$base" ]] && gh_args+=(--base "$base")
        [[ -n "$name" ]] && gh_args+=(--name "$name")
        echo ">> issue $issue ($issue_repo) -> linked branch in $branch_repo" >&2
        gh issue develop "${gh_args[@]}"
    done
