// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "terminal": {
    "copy_on_select": true,
    "font_size": 14.0
  },
  "reveal_if_open": true,
  "markdown_preview": {
    "open_markdown_files_in_preview": true,
    "font_family": "SF Pro Text",
    "code_font_family": "FiraCode Nerd Font Mono",
    "font_size": 14.0
  },
  "proxy": "",
  "toolbar": {
    "code_actions": true
  },
  "agent_servers": {
    "gemini": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "outline_panel": {
    "dock": "right"
  },
  "agent_ui_font_size": 15.0,
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "dock": "left",
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "status_bar": {
    "active_language_button": true
  },
  "project_panel": {
    "git_status_indicator": true,
    "dock": "left",
    "button": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  // NOTE: Mirrors nvim-snazzy's @lsp.mod.* and @lsp.type.* groups. The style
  // names only exist in the Snazzy theme, so other themes ignore these rules
  // (apart from the deprecated strikethrough). Earlier rules win per field.
  "global_lsp_settings": {
    "semantic_token_rules": [
      { "token_modifiers": ["deprecated"], "style": ["lsp.mod.deprecated"], "strikethrough": true },
      { "token_modifiers": ["readonly"], "style": ["lsp.mod.readonly"] },
      { "token_modifiers": ["static"], "style": ["lsp.mod.static"] },
      { "token_modifiers": ["async"], "style": ["lsp.mod.async"] },
      { "token_modifiers": ["abstract"], "style": ["lsp.mod.abstract"] },
      { "token_modifiers": ["global"], "style": ["lsp.mod.global"] },
      { "token_modifiers": ["defaultLibrary"], "style": ["lsp.mod.defaultLibrary"] },
      { "token_modifiers": ["documentation"], "style": ["lsp.mod.documentation"] },
      { "token_modifiers": ["modification"], "style": ["lsp.mod.modification"] },
      { "token_modifiers": ["definition"], "style": ["lsp.mod.definition"] },
      { "token_type": "class", "style": ["lsp.type.class"] },
      { "token_type": "enum", "style": ["lsp.type.enum"] },
      { "token_type": "interface", "style": ["lsp.type.interface"] },
      { "token_type": "struct", "style": ["lsp.type.struct"] },
      { "token_type": "typeParameter", "style": ["lsp.type.typeParameter"] },
      { "token_type": "macro", "style": ["lsp.type.macro"] }
    ]
  },
  "colorize_brackets": true,
  "inlay_hints": {
    "enabled": true
  },
  "which_key": {
    "enabled": true
  },
  "session": {
    "trust_all_worktrees": true
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true
  },
  "ui_font_family": ".ZedSans",
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 16.0,
  "agent_buffer_font_size": 13.0,
  "prettier": {
    "allowed": true
  },
  "format_on_save": "off",
  "tab_size": 2,
  "auto_signature_help": true,
  "context_servers": {
    "mcp-server-context7": {
      "enabled": true,
      "settings": {
        "default_minimum_tokens": "10000"
      }
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "open_ai_compatible_api": {
      "prompt_format": "qwen",
      "api_url": "http://localhost:8000/v1/completions",
      "model": "henrik3/sweep-next-edit-v2-7B"
    },
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "theme": {
    "mode": "system",
    "light": "GitHub Light",
    "dark": "Snazzy"
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "metrics": false
  },
  "buffer_font_size": 15.0,
  "buffer_font_family": "Fira Code",
  "buffer_font_fallbacks": ["FiraCode Nerd Font"],
  "vim_mode": true,
  "vim": {
    "use_smartcase_find": true,
    "highlight_on_yank_duration": 150
  },
  "vertical_scroll_margin": 5,
  "soft_wrap": "none",
  "command_aliases": {
    "W": "w",
    "Wq": "wq",
    "Qa": "qa"
  },
  "preferred_line_length": 100,
  "projects_online_by_default": false,
  "copy_on_select": true
}
