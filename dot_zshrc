# Override zoxide: always show frecency-ranked results on tab
if (( $+commands[zoxide] ))
then
  function __zoxide_z_complete() {
    [[ "${#words[@]}" -eq "${CURRENT}" ]] || return 0
    local -a paths entries local_dirs
    paths=("${(@f)$(zoxide query -l -- ${words[2,-1]} 2>/dev/null)}")
    local p short
    for p in "${paths[@]}"; do
      [[ -z "$p" ]] && continue
      short="${p/#$HOME/~}"
      entries+=("${p:t}:${short}")
    done
    local_dirs=( *(N/) )
    for p in "${local_dirs[@]}"; do
      entries+=("${p}:./${p}")
    done
    _describe 'zoxide directory' entries -U
    return 0
  }
  compdef __zoxide_z_complete z
  zstyle ':completion:*:zoxide-directory:*' sort false
  zstyle ':fzf-tab:complete:z:*' fzf-preview 'eza -1 --color=always $(zoxide query -- $word 2>/dev/null)'
fi

# --- LLM helpers ---

# Thin shim — canonical impl lives in the global justfile (J llm-commit-message).
# Forwards args (e.g. -p claude, -m Qwen3.6-27B) straight through.
generate_commit_message() { J llm-commit-message "$@"; }

export PATH="$HOME/.local/bin:$PATH" # wezcld
if [[ $_prompt_choice == p10k ]]; then
  (( ! ${+functions[p10k-instant-prompt-finalize]} )) || p10k-instant-prompt-finalize
  [[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
else
  # zim compiles .zimrc into a static init.zsh at build time, so p10k is
  # loaded unconditionally before we get here. Strip its precmd/preexec
  # hooks via array-filter (${array[@]:#pattern} keeps non-matching) so
  # starship owns the prompt without interference.
  precmd_functions=(${precmd_functions[@]:#_p9k_*})
  preexec_functions=(${preexec_functions[@]:#_p9k_*})
  eval "$(starship init zsh)"
fi
unset _prompt_choice

if [[ -t 1 && -z $CLAUDECODE ]] && (( $+commands[pokemon-colorscripts] ))
then
  pokemon-colorscripts -r --no-title
fi

# Agent hygiene: strip interactive-only aliases from agent/pipe shells so
# command-shadowing (diff→delta, ssh→kitten) doesn't leak into Claude Code
# snapshots or other agents' `zsh -ic` environments.
if [[ ! -t 1 || -n $CLAUDECODE ]]; then
  unalias diff ssh obsidian df du 2>/dev/null
fi
