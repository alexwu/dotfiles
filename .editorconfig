# EditorConfig — https://editorconfig.org
# Scoped to shell formatting for shfmt (3.13+). shfmt reads these options
# directly; note that passing ANY parser/printer flag on the shfmt CLI disables
# the entire EditorConfig, so invocations must pass none (just `shfmt -w .`).
root = true

# Shell scripts. shfmt's own [[shell]] matcher (outside the EditorConfig spec)
# catches scripts by shebang/dialect — including the extensionless helpers under
# dot_local/bin that no *.sh glob would reach. The *.{sh,bash} glob is kept so
# editors, which don't understand the [[...]] matchers, apply the same indent.
[*.{sh,bash}]
indent_style = space
indent_size = 2

[[shell]]
indent_style = space
indent_size = 2
shell_variant = bash
switch_case_indent = true

# zsh scripts. shfmt 3.7+ parses and formats zsh; naming the dialect stops it
# from reading them as bash (which fails on zsh-only syntax). This section
# follows [[shell]] so shell_variant=zsh wins for *.zsh files.
[*.zsh]
indent_style = space
indent_size = 2
shell_variant = zsh
switch_case_indent = true

# Generated by the Powerlevel10k wizard — leave byte-for-byte so re-running the
# wizard produces a clean diff.
[dot_p10k.zsh]
ignore = true
