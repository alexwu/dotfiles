#!/usr/bin/env bash
# zn — attach to a freshly-named zmx session.
#
# Companion to `dbzname`. On PATH so wezterm's split/tab spawn calls
# can invoke it directly without sourcing zshrc.

# GUI-launched callers (wezterm, etc.) inherit a minimal launchd PATH;
# dbzname lives in ~/.local/bin, zmx in /opt/homebrew/bin.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

# Homebrew zsh end-to-end. Two layers each spawn "$SHELL": zmx's daemon
# (login shell), then atuin's pty-proxy after `exec atuin pty-proxy` in
# zshrc (portable_pty new_default_prog reads $SHELL). Apple /bin/zsh hides
# its exec-time env from `ps eww` (KERN_PROCARGS2); homebrew zsh exposes
# it, so session shells stay inspectable by zmx-env/zmx-ps.
export SHELL=/opt/homebrew/bin/zsh
exec zmx attach "$(dbzname)"
