#!/usr/bin/env bash
# zmx-reap — kill detached zmx sessions (clients=0) whose process tree is idle.
#
# A detached session may still host live work: a claude/codex agent, an nvim
# with unsaved buffers, a build. Reapable = the daemon's descendant tree is
# empty or contains nothing but shells. Anything else marks the session active
# and it is always skipped — kill those manually with `zmx kill <name>`.
#
# "active" is SESSION OCCUPANCY (something is running), NOT a Claude agent's
# own "busy" turn-status — a session can be active with no agent in it at all.
#
# Occupancy (active|idle) + session metadata are delegated to `zmx-ps`, the
# single source of truth — reap categorizes its JSON and only ever kills
# detached+idle. No independent process-tree walk lives here anymore; when
# zmx-ps is ported to Nim, reap rides along for free.
#
# Usage: zmx-reap            # dry run: table of detached sessions + verdicts
#        zmx-reap --kill     # kill the reapable ones
#        zmx-reap --all      # also list attached sessions (dim, never reaped)

set -uo pipefail
# Pin TMPDIR to the launchd GUI temp so zmx resolves the real sockets
# regardless of launch context (Claude namespaces TMPDIR; GUI apps don't).
export TMPDIR="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

kill_mode=0
show_all=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --kill | -k)
      kill_mode=1
      shift
      ;;
    --all | -a)
      show_all=1
      shift
      ;;
    *)
      echo "usage: zmx-reap [--kill] [--all]" >&2
      exit 2
      ;;
  esac
done

b=$'\e[1m'
dim=$'\e[2m'
red=$'\e[31m'
grn=$'\e[32m'
ylw=$'\e[33m'
rst=$'\e[0m'

fmt_age() {
  local s=$1
  if ((s < 3600)); then
    printf '%dm' $((s / 60))
  elif ((s < 86400)); then
    printf '%dh' $((s / 3600))
  else
    printf '%dd' $((s / 86400))
  fi
}

# Single zmx-ps snapshot: the oracle for occupancy + metadata.
ps_json=$(zmx-ps 2>/dev/null)
[[ -z "$ps_json" ]] && ps_json='[]'

reap=()
active_n=0
attached_n=0

printf '%s%-44s %-4s %-18s %s%s\n' "$b" NAME AGE VERDICT DIR "$rst"
# Per session: cat = reap (detached+idle) | active (detached+active, skipped)
# | attached (clients>0, skipped). Fields joined on \x1f so an empty `running`
# can't collapse the row (tab is IFS-whitespace; US is not).
while IFS=$'\x1f' read -r cat name age_s running dir; do
  [[ -z "${name:-}" ]] && continue
  age=$(fmt_age "$age_s")
  case "$cat" in
    reap)
      reap+=("$name")
      printf '%-44s %-4s %sreap%s              %s%s%s\n' \
        "$name" "$age" "$red" "$rst" "$dim" "$dir" "$rst"
      ;;
    active)
      ((active_n++))
      printf '%-44s %-4s %sactive:%-11s%s %s%s%s\n' \
        "$name" "$age" "$ylw" "$running" "$rst" "$dim" "$dir" "$rst"
      ;;
    attached)
      # Counted so an all-attached world reads as "saw N, skipped them", not a
      # dead tool. With --all, listed too so reap doubles as a session inventory.
      ((attached_n++))
      ((show_all)) && printf '%-44s %-4s %sattached%s          %s%s%s\n' \
        "$name" "$age" "$dim" "$rst" "$dim" "$dir" "$rst"
      ;;
  esac
done < <(printf '%s' "$ps_json" | jaq -r '
  .[]
  | [ (if .clients > 0 then "attached"
       elif .state == "active" then "active"
       else "reap" end),
      .name, (.age_s | tostring), (.running // ""), .start_dir ]
  | join("\u001f")')

echo
if ((${#reap[@]} == 0)); then
  printf '%snothing to reap%s (%d detached-active, %d attached — all skipped)\n' \
    "$grn" "$rst" "$active_n" "$attached_n"
  exit 0
fi

if ((kill_mode)); then
  zmx kill "${reap[@]}"
  printf '%skilled %d session(s)%s, %d active + %d attached skipped\n' \
    "$grn" "${#reap[@]}" "$rst" "$active_n" "$attached_n"
else
  printf '%d reapable, %d active + %d attached skipped — dry run. Re-run with %s--kill%s to execute.\n' \
    "${#reap[@]}" "$active_n" "$attached_n" "$b" "$rst"
fi
