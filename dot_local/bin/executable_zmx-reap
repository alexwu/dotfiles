#!/usr/bin/env bash
# zmx-reap — kill detached zmx sessions (clients=0) whose process tree is idle.
#
# A detached session may still host live work: a claude/codex agent, an nvim
# with unsaved buffers, a build. Reapable = the daemon's descendant tree is
# empty or contains nothing but shells. Anything else marks the session busy
# and it is always skipped — kill those manually with `zmx kill <name>`.
#
# Usage: zmx-reap            # dry run: table of detached sessions + verdicts
#        zmx-reap --kill     # kill the reapable ones

set -uo pipefail
# Pin TMPDIR to the launchd GUI temp so zmx resolves the real sockets
# regardless of launch context (Claude namespaces TMPDIR; GUI apps don't).
export TMPDIR="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

kill_mode=0
case "${1:-}" in
  --kill|-k) kill_mode=1 ;;
  "") ;;
  *) echo "usage: zmx-reap [--kill]" >&2; exit 2 ;;
esac

b=$'\e[1m'; dim=$'\e[2m'; red=$'\e[31m'; grn=$'\e[32m'; ylw=$'\e[33m'; rst=$'\e[0m'

snapshot=$(ps -axo pid=,ppid=,command=)

# First working descendant's name under a daemon pid, or empty if idle.
# Shells and the atuin pty-proxy are infrastructure: ignored, but traversed.
busy_of() {
  awk -v root="$1" '
    {
      pid=$1; ppid=$2; cmd=$3
      for (i=4; i<=NF; i++) cmd = cmd " " $i
      kids[ppid] = kids[ppid] " " pid; name[pid] = cmd
    }
    END {
      top = 0
      n = split(kids[root], q, " ")
      for (qi=1; qi<=n; qi++) if (q[qi] != "") stack[++top] = q[qi]
      while (top > 0) {
        p = stack[top--]
        base = name[p]; sub(/ .*/, "", base); sub(/.*\//, "", base); sub(/^-/, "", base)
        infra = (base ~ /^(sh|bash|zsh|fish|dash)$/) || \
                (base == "atuin" && name[p] ~ /pty-proxy/)
        if (!infra) { print base; exit }
        m = split(kids[p], q2, " ")
        for (qi=1; qi<=m; qi++) if (q2[qi] != "") stack[++top] = q2[qi]
      }
    }' <<< "$snapshot"
}

fmt_age() {
  local s=$1
  if   (( s < 3600 ));  then printf '%dm' $(( s / 60 ))
  elif (( s < 86400 )); then printf '%dh' $(( s / 3600 ))
  else                       printf '%dd' $(( s / 86400 ))
  fi
}

now=$(date +%s)
reap=()
busy_n=0

printf '%s%-44s %-4s %-18s %s%s\n' "$b" NAME AGE VERDICT DIR "$rst"
while IFS=$'\t' read -r name pid clients created dir; do
  [[ -z "${name:-}" || "${clients:-0}" != 0 ]] && continue
  age=$(fmt_age $(( now - created )))
  busy=$(busy_of "$pid")
  if [[ -n "$busy" ]]; then
    (( busy_n++ ))
    printf '%-44s %-4s %sbusy:%-13s%s %s%s%s\n' "$name" "$age" "$ylw" "$busy" "$rst" "$dim" "$dir" "$rst"
  else
    reap+=("$name")
    printf '%-44s %-4s %sreap%s               %s%s%s\n' "$name" "$age" "$red" "$rst" "$dim" "$dir" "$rst"
  fi
done < <(zmx list 2>/dev/null | awk -F'\t' '{
    delete a
    for (i=1; i<=NF; i++) {
      n = index($i, "="); if (n == 0) continue
      k = substr($i, 1, n-1); gsub(/^[^a-z_]+/, "", k)
      a[k] = substr($i, n+1)
    }
    if (a["name"] != "")
      print a["name"] "\t" a["pid"] "\t" a["clients"] "\t" a["created"] "\t" a["start_dir"]
  }')

echo
if (( ${#reap[@]} == 0 )); then
  printf '%snothing to reap%s (%d busy skipped)\n' "$grn" "$rst" "$busy_n"
  exit 0
fi

if (( kill_mode )); then
  zmx kill "${reap[@]}"
  printf '%skilled %d session(s)%s, %d busy skipped\n' "$grn" "${#reap[@]}" "$rst" "$busy_n"
else
  printf '%d reapable, %d busy skipped — dry run. Re-run with %s--kill%s to execute.\n' \
    "${#reap[@]}" "$busy_n" "$b" "$rst"
fi
