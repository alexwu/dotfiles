#!/usr/bin/env bash
# Run a heavy command through pueue so builds and tests from every agent and
# terminal share one limit, and give back the command's own exit status.
set -euo pipefail

prog=pq
group=
label=
detach=0
follow_id=
status=0
all=0
json=0

usage() {
  cat <<EOF
Queue a command in pueue, follow its output, and exit with its status.

Usage: $prog [OPTIONS] [--] COMMAND [ARG...]
       $prog --follow ID
       $prog --status [--all] [--json]

Arguments:
  COMMAND [ARG...]  Command to run, in the current directory and environment

Options:
  -g, --group GROUP  pueue group: cpu (builds and full test suites, 2 at once),
                     checks (lint, typecheck, light tests, 2), net (downloads,
                     3), or any group that exists. Default: chosen from COMMAND
  -l, --label LABEL  Label for the task. Default: <directory name>: <COMMAND>
      --detach       Queue COMMAND, print its task id on stdout and return
      --follow ID    Follow task ID and exit with its status
      --status       List the tasks you queued and how each ended
      --all          With --status, list every task
      --json         With --status, print the tasks as a JSON array
  -h, --help         Print help

The groups are the standing ones from the pueue skill. cpu and checks tasks run
under 'taskpolicy -c utility', so they give way to whatever you are doing, and
get NEXTEST_TEST_THREADS=9 unless it is already set. The limits are counts of
tasks: they bound memory first.

There is no way to run a task at full priority from here: launchd starts
pueued with light throttling, and every task inherits it.

Exit status is COMMAND's own. 125 means the task could not be queued or its
result could not be read; 137 that it was killed; 2 a usage error.
Interrupting $prog kills the task. Time spent waiting for a slot counts
against any timeout the caller has.

A task queued with --detach from a Claude Code session running the knock mod
reports back when it finishes: pueue's callback runs pueue-knock, which sends
that session the task's id, result and label.

Every run removes tasks that finished more than a day ago, so --status lists
the last day's tasks.

--status prints a table on stdout: id, group, state, exit code, label. Inside
a Claude Code session the tasks are the ones that session queued, matched on
the CLAUDE_PID pueue stored with each. Anywhere else they are the ones queued
from the current directory or below it. A line on stderr says which.

Examples:
  $prog -- cargo build --release
  $prog -g cpu -l "claude:eo: rspec-orders" -- bundle exec rspec spec/orders
  id=\$($prog --detach -- just ci) && $prog --follow "\$id"
EOF
}

note() { echo "$prog: $*" >&2; }

usage_error() {
  note "$*"
  note "try '$prog --help'"
  exit 2
}

setup_error() {
  note "$*"
  exit 125
}

while (($#)); do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -g | --group)
      (($# >= 2)) || usage_error "--group needs a name"
      group=$2
      shift
      ;;
    --group=*) group=${1#*=} ;;
    -l | --label)
      (($# >= 2)) || usage_error "--label needs a value"
      label=$2
      shift
      ;;
    --label=*) label=${1#*=} ;;
    --detach) detach=1 ;;
    --follow)
      (($# >= 2)) || usage_error "--follow needs a task id"
      follow_id=$2
      shift
      ;;
    --follow=*) follow_id=${1#*=} ;;
    --status) status=1 ;;
    --all) all=1 ;;
    --json) json=1 ;;
    --)
      shift
      break
      ;;
    -*) usage_error "unknown option '$1'" ;;
    *) break ;;
  esac
  shift
done

[[ -z $follow_id || $follow_id =~ ^[0-9]+$ ]] ||
  usage_error "--follow needs a numeric task id, got '$follow_id'"
[[ -z $group || $group =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
  usage_error "invalid group '$group'"
if ((status)); then
  if [[ -n $follow_id ]] || ((detach)); then
    usage_error "--status goes with --all and --json only"
  fi
  (($# == 0)) || usage_error "--status takes no COMMAND"
else
  ((all == 0 && json == 0)) || usage_error "--all and --json go with --status"
fi

# Pick a group from the command when none was given. Unknown commands go to
# cpu, the strictest group.
group_for() {
  case "$1 ${2:-}" in
    "cargo fmt" | "cargo clippy" | "cargo check" | "srb tc") echo checks ;;
    "just lint"* | "just fmt"* | "just check"*) echo checks ;;
    "git clone" | "ollama pull") echo net ;;
    *)
      case $1 in
        rubocop | rumdl | shellcheck | nph) echo checks ;;
        curl | xh | wget | aria2c | hf | huggingface-cli) echo net ;;
        *) echo cpu ;;
      esac
      ;;
  esac
}

task_id=
follow_pid=

# NOTE: bash defers a trap until the foreground command returns, so the follow
# runs in the background and `wait` is what a signal interrupts.
# shellcheck disable=SC2329 # invoked from the traps in follow_and_exit
on_signal() {
  trap - INT TERM
  [[ -z $follow_pid ]] || kill "$follow_pid" 2>/dev/null || true
  if [[ -n $task_id ]]; then
    pueue kill "$task_id" >/dev/null 2>&1 || true
    note "interrupted: killed task $task_id"
  fi
  exit "$1"
}

# `pueue follow` and `pueue wait` exit 0 whatever the task did, so the status
# comes from the JSON.
follow_and_exit() {
  local result status
  trap 'on_signal 130' INT
  trap 'on_signal 143' TERM
  pueue wait "$task_id" --status running --quiet >/dev/null 2>&1 &
  follow_pid=$!
  wait "$follow_pid" || true
  pueue follow "$task_id" &
  follow_pid=$!
  wait "$follow_pid" || true
  pueue wait "$task_id" --quiet >/dev/null 2>&1 &
  follow_pid=$!
  wait "$follow_pid" || true
  follow_pid=
  trap - INT TERM

  # shellcheck disable=SC2016 # $id and $s are jaq variables
  result=$(pueue status --json | jaq -r --arg id "$task_id" '
    .tasks[$id].status as $s
    | if $s == null then "missing"
      elif ($s | type) != "object" or ($s | has("Done") | not) then "unfinished"
      else ($s.Done.result | if type == "object" then (to_entries[0] | "\(.key) \(.value)") else . end)
      end') || setup_error "couldn't read task $task_id's status"
  case $result in
    Success) status=0 ;;
    "Failed "*) status=${result#Failed } ;;
    Killed) status=137 ;;
    unfinished) setup_error "task $task_id has not finished; pick it up with --follow $task_id" ;;
    missing) setup_error "no task $task_id" ;;
    *) setup_error "task $task_id ended as '$result'" ;;
  esac
  ((status == 0)) || note "task $task_id exit $status"
  exit "$status"
}

# Whose tasks --status lists: every one, this Claude Code session's, or this
# directory's.
# NOTE: the session is matched on its process id and not its session id,
# because /clear gives a running session a new session id.
show_status() {
  local mode=all key='' rows
  if ((all)); then
    note "every task"
  elif [[ ${CLAUDE_PID:-} =~ ^[0-9]+$ ]]; then
    mode=pid key=$CLAUDE_PID
    note "tasks this Claude Code session queued (pid $key); --all lists every task"
  else
    mode=dir key=$PWD
    note "tasks queued from $PWD or below; --all lists every task"
  fi

  # shellcheck disable=SC2016 # $mode and $key are jaq variables
  rows=$(pueue status --json | jaq -c --arg mode "$mode" --arg key "$key" '
    def state:
      if type != "object" then ascii_downcase
      elif has("Done") | not then (keys[0] | ascii_downcase)
      else (.Done.result | if . == "Success" then "done" elif type == "object" then (keys[0] | ascii_downcase) else ascii_downcase end)
      end;
    def exit_code:
      if type != "object" or (has("Done") | not) then null
      else (.Done.result | if . == "Success" then 0 elif type == "object" then (to_entries[0].value | if type == "number" then . else null end) else null end)
      end;
    [.tasks | to_entries | sort_by(.key | tonumber) | .[] | .value
      | select($mode == "all"
          or ($mode == "pid" and (.envs.CLAUDE_PID // "") == $key)
          or ($mode == "dir" and (.path == $key or (.path | startswith($key + "/")))))
      | {id, group, state: (.status | state), exit_code: (.status | exit_code), label: (.label // null), path, command}]') ||
    setup_error "couldn't read pueue's tasks"

  if ((json)); then
    printf '%s\n' "$rows"
  else
    jaq -r '["ID", "GROUP", "STATE", "EXIT", "LABEL"],
      (.[] | [.id, .group, .state, (.exit_code // "-"), ((.label // .command) | gsub("[\\x00-\\x1f\\x7f]+"; " ") | .[0:80])])
      | @tsv' <<<"$rows" | column -t -s $'\t'
  fi
  exit 0
}

# Each task keeps the environment it was queued with, and every pueue call
# that waits on a task downloads the daemon's whole state, so finished tasks
# piled up into tens of MB per poll (lulu-loadout-0fa). Tasks that finished
# more than a day ago are removed; a failure here never stops the run.
prune_finished() {
  local ids
  # shellcheck disable=SC2016 # $cutoff is a jaq variable
  ids=$(pueue status --json 2>/dev/null | jaq -r --argjson cutoff "$(($(date +%s) - 86400))" '
    [.tasks[]
      | select((.status | type) == "object" and (.status | has("Done")))
      | select(.status.Done.end | sub("\\.[0-9]+"; "") | fromdateiso8601 < $cutoff)
      | .id | tostring] | join(" ")') || return 0
  [[ -n $ids ]] || return 0
  local -a list
  read -ra list <<<"$ids"
  pueue remove "${list[@]}" >/dev/null 2>&1 || true
}

command -v pueue >/dev/null 2>&1 || setup_error "pueue is not installed"
command -v jaq >/dev/null 2>&1 || setup_error "jaq is not installed"
pueue status --json >/dev/null 2>&1 || setup_error "the pueue daemon is not running"
prune_finished

((status == 0)) || show_status

if [[ -n $follow_id ]]; then
  task_id=$follow_id
  follow_and_exit
fi

(($# > 0)) || usage_error "expected a COMMAND to run"

[[ -n $group ]] || group=$(group_for "$@")

# Groups live in the daemon's state, not in pueue.yml, so the standing ones
# from the pueue skill are created on first use, with the skill's limits.
# shellcheck disable=SC2016 # $g is a jaq variable
group_known=$(pueue status --json | jaq -r --arg g "$group" '.groups | has($g)')
if [[ $group_known != true ]]; then
  case $group in
    cpu) pueue group add cpu --parallel 2 >/dev/null ;;
    checks) pueue group add checks --parallel 2 >/dev/null ;;
    net) pueue group add net --parallel 3 >/dev/null ;;
    *) usage_error "no pueue group '$group'; create it with 'pueue group add $group'" ;;
  esac
fi

# NOTE: the clamp is already in force when launchd runs pueued. It is set here
# too so it holds for a daemon someone started by hand.
prefix=()
if [[ $group == cpu || $group == checks ]]; then
  prefix+=(taskpolicy -c utility)
  [[ -n ${NEXTEST_TEST_THREADS:-} ]] || prefix+=(env NEXTEST_TEST_THREADS=9)
fi

[[ -n $label ]] || label="${PWD##*/}: $*"

# pueue keeps the client's environment with the task. pueue-knock, the daemon's
# callback, reads this mark there and tells the session that queued a detached
# task when it finishes. It is unset otherwise so a pq run inside a detached
# task doesn't inherit it.
if ((detach)); then
  export PQ_DETACHED=1
else
  unset PQ_DETACHED
fi
# LS_COLORS is ~18 KB of each task's ~38 KB of stored environment, and no
# build reads it. Dropping it keeps a day of tasks under pueue's 20 MiB
# "large payload" line for longer (lulu-loadout-0fa).
unset LS_COLORS

task_id=$(pueue add --group "$group" --label "$label" --print-task-id --escape --working-directory "$PWD" -- ${prefix[@]+"${prefix[@]}"} "$@") ||
  setup_error "couldn't queue the command"
[[ $task_id =~ ^[0-9]+$ ]] || setup_error "pueue returned '$task_id' instead of a task id"

if ((detach)); then
  note "task $task_id queued in $group"
  echo "$task_id"
  exit 0
fi

note "task $task_id in $group: $*"
follow_and_exit
