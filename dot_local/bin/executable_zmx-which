#!/usr/bin/env bash
# zmx-which — which zmx session is each Claude agent running in?
#
# The one place that associates `claude agents --json` entries with zmx
# sessions; agent-sessions and mission-control read its --json. Each agent is
# resolved by the first source that answers:
#
#   label         the session carries agent=claude and a claude_session label
#                 equal to the agent's sessionId (set by zmx-agent-label from
#                 Claude's SessionStart hook)
#   process_env   ZMX_SESSION in the agent's exec-time env (KERN_PROCARGS2 via
#                 `ps eww`). Works because claude is a third-party binary;
#                 Apple platform binaries hide their env (see zmx-env).
#   process_tree  the agent's pid is a descendant of the session's daemon
#
# A label left behind by a crashed agent matches no live sessionId, so it is
# ignored rather than trusted.
#
# Usage: zmx-which [--json] [session|pid]
#   session|pid   only rows for one session name or agent pid
#   --json        one object per agent that has a pid:
#     { pid, kind, status, session_id, cwd, zmx_session, association_source,
#       clients, occ }
#     association_source: "label" | "process_env" | "process_tree" | null
#     occ: the session's occupancy (active|idle) from zmx-ps, not the agent's
#     turn status

set -uo pipefail
export TMPDIR="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

json=0
filter=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json)
      json=1
      shift
      ;;
    -h | --help)
      awk 'NR > 1 { if (!/^#/) exit; sub(/^# ?/, ""); print }' "$0"
      exit 0
      ;;
    -*)
      echo "zmx-which: unknown flag '$1' (see --help)" >&2
      exit 2
      ;;
    *)
      filter="$1"
      shift
      ;;
  esac
done

sessions=$(zmx-ps 2>/dev/null)
[[ -n "$sessions" ]] || sessions='[]'
agents=$(claude agents --json 2>/dev/null)
[[ -n "$agents" ]] || agents='[]'

# Shared by both passes: agents with a pid, and sessionId -> labelled session.
defs='
  def agents: $agents[0] | map(select(.pid != null));
  def by_label: $sessions[0]
    | map(select(.labels.agent == "claude" and .labels.claude_session != null)
        | { key: .labels.claude_session, value: .name })
    | from_entries;'

# Only agents no label claims pay for a `ps eww`.
env_tsv=$(jaq -nr --slurpfile agents <(printf '%s' "$agents") \
  --slurpfile sessions <(printf '%s' "$sessions") "$defs"'
    by_label as $l | agents[] | select($l[.sessionId // ""] == null) | .pid' |
  while read -r pid; do
    zs=$(ps eww -p "$pid" 2>/dev/null | rg -o -m1 'ZMX_SESSION=[^ ]+' | cut -d= -f2)
    [[ -n "$zs" ]] && printf '%s\t%s\n' "$pid" "$zs"
  done)

out=$(jaq -n --slurpfile agents <(printf '%s' "$agents") \
  --slurpfile sessions <(printf '%s' "$sessions") \
  --rawfile env <(printf '%s' "$env_tsv") --arg filter "$filter" "$defs"'
    by_label as $l
    | ($env | split("\n") | map(select(length > 0) | split("\t") | { key: .[0], value: .[1] })
        | from_entries) as $e
    | ($sessions[0] | map(.name as $n | .procs[] | { key: (.pid | tostring), value: $n })
        | from_entries) as $t
    | ($sessions[0] | map({ key: .name, value: . }) | from_entries) as $s
    | agents
    | map((.pid | tostring) as $p
        | (if $l[.sessionId // ""] then { zmx_session: $l[.sessionId], association_source: "label" }
           elif $e[$p] then { zmx_session: $e[$p], association_source: "process_env" }
           elif $t[$p] then { zmx_session: $t[$p], association_source: "process_tree" }
           else { zmx_session: null, association_source: null } end) as $a
        | { pid, kind, status: (.status // .state // null), session_id: (.sessionId // null),
            cwd: (.cwd // null) } + $a
        | .clients = ($s[.zmx_session // ""].clients // null)
        | .occ = ($s[.zmx_session // ""].state // null))
    | map(select($filter == "" or .zmx_session == $filter or (.pid | tostring) == $filter))')

if ((json)); then
  printf '%s\n' "$out"
  exit 0
fi

b=$'\e[1m'
dim=$'\e[2m'
rst=$'\e[0m'

printf '%s%-6s %-12s %-8s %-40s %-3s %-12s %s%s\n' "$b" PID KIND STATUS SESSION CL VIA CWD "$rst"
# Joined on \x1f: tab is IFS whitespace, so an empty field would shift the row.
jaq -r '.[] | [ (.pid | tostring), .kind, (.status // "?"), (.zmx_session // "-"),
    ((.clients // "-") | tostring), (.association_source // "-"), (.cwd // "") ]
  | join("\u001f")' <<<"$out" |
  while IFS=$'\x1f' read -r apid akind ast zs cl via acwd; do
    printf '%-6s %-12s %-8s %-40s %-3s %-12s %s%s%s\n' \
      "$apid" "$akind" "$ast" "$zs" "$cl" "$via" "$dim" "$acwd" "$rst"
  done
