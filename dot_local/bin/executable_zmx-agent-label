#!/usr/bin/env bash
# zmx-agent-label — record a coding agent's identity on its ambient zmx session.
#
# Runs from the agent's lifecycle hooks with the hook JSON on stdin and labels
# $ZMX_SESSION so discovery (zmx-ps, zmx-which) can read the association instead
# of inferring it from process env:
#
#   agent=<agent>  <agent>_session=<session id>  <agent>_pid=<agent pid>
#
# Labels carry identity only. Turn state (busy/waiting/idle) stays with the
# agent's own status API.
#
# Usage: zmx-agent-label set <agent>     # SessionStart: startup, resume, clear, compact
#        zmx-agent-label unset <agent>   # SessionEnd
#
# set    overwrites the labels, unless another live agent process already owns
#        them: a nested agent (claude -p from a tool call) inherits ZMX_SESSION
#        and must not take over its parent's session.
# unset  removes this agent's three keys, and only while <agent>_session still
#        names the ending session. /clear ends one id and starts the next; the
#        guard keeps a late SessionEnd from erasing the new id. Other labels
#        and the session itself are never touched.
#
# Always exits 0 outside a usage error, so a hook can't block the agent.
# Diagnostics go to stderr.

set -uo pipefail
# Agents namespace TMPDIR; zmx's sockets live under the launchd GUI temp.
export TMPDIR="$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")"
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

action="${1:-}"
agent="${2:-}"
if [[ ! "$action" =~ ^(set|unset)$ || ! "$agent" =~ ^[a-z][a-z0-9]*$ ]]; then
  echo "usage: zmx-agent-label set|unset <agent>   (hook JSON on stdin)" >&2
  exit 2
fi

[[ -n "${ZMX_SESSION:-}" ]] || exit 0

payload=""
[[ -t 0 ]] || payload=$(cat)
sid=$(jaq -r '.session_id // empty' <<<"$payload" 2>/dev/null) || sid=""
# Label values accept only [A-Za-z0-9._-]; anything else would be rejected.
if [[ ! "$sid" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "zmx-agent-label: no usable session_id on stdin, leaving labels alone" >&2
  exit 0
fi

label() { zmx get . "$1" 2>/dev/null || true; }

case "$action" in
  set)
    pid="${CLAUDE_PID:-}"
    [[ "$pid" =~ ^[0-9]+$ ]] || pid=""
    owner=$(label "${agent}_pid")
    if [[ -n "$owner" && -n "$pid" && "$owner" != "$pid" ]] && kill -0 "$owner" 2>/dev/null; then
      echo "zmx-agent-label: $ZMX_SESSION is labelled for live pid $owner, not relabelling" >&2
      exit 0
    fi
    zmx set . "agent=$agent" "${agent}_session=$sid" "${agent}_pid=$pid" >/dev/null ||
      echo "zmx-agent-label: could not label $ZMX_SESSION" >&2
    ;;
  unset)
    [[ "$(label "${agent}_session")" == "$sid" ]] || exit 0
    zmx set . "agent=" "${agent}_session=" "${agent}_pid=" >/dev/null ||
      echo "zmx-agent-label: could not clear labels on $ZMX_SESSION" >&2
    ;;
esac
exit 0
